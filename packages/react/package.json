{
  "name": "@open-mercato/cezar-react",
  "version": "0.10.0",
  "description": "React providers, components, and the complete embeddable Cezar cockpit.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "licenses", "README.md"],
  "sideEffects": ["./dist/styles.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./cockpit": { "types": "./dist/cockpit.d.ts", "import": "./dist/cockpit.js" },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "dependencies": {
    "@open-mercato/cezar-api-client": "^0.10.0",
    "@tanstack/react-query": "^5.101.2"
  },
  "scripts": {
    "build": "npm run check:boundaries && vite build && node scripts/scope-css.mjs && node scripts/verify-css.mjs dist/styles.css && tsc --emitDeclarationOnly -p tsconfig.json && node scripts/verify-cockpit-artifact.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check:boundaries": "node scripts/check-import-boundaries.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.19",
    "postcss-selector-parser": "^7.1.1",
    "postcss-value-parser": "^4.2.0",
    "react-router": "^7.18.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-mercato/cezar",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  }
}
