{
  "version": 1,
  "delivery": {
    "mode": "stage-only"
  },
  "retry": {
    "maxAttempts": 4,
    "backoffMs": 5000,
    "backoffMultiplier": 2,
    "timeoutEscalation": 1.5,
    "maxTimeoutMs": 2400000
  },
  "models": {
    "codex": {
      "adapter": "command",
      "family": "openai",
      "model": "gpt-5.6-sol",
      "reasoningEffort": "xhigh",
      "roles": [
        "reviewer"
      ],
      "timeoutMs": 1200000,
      "commands": {
        "probe": [
          "codex",
          "--version"
        ],
        "review": [
          "codex",
          "exec",
          "--ignore-user-config",
          "--ignore-rules",
          "--ephemeral",
          "--config",
          "model_reasoning_effort={reasoningEffort}",
          "--sandbox",
          "read-only",
          "--cd",
          "{worktree}",
          "--model",
          "{model}",
          "--output-schema",
          "{schemaFile}",
          "-"
        ]
      }
    },
    "deepseek": {
      "adapter": "preset",
      "preset": "deepseek-api",
      "family": "deepseek",
      "model": "deepseek-v4-pro",
      "roles": [
        "reviewer"
      ],
      "endpoint": "https://api.deepseek.com/chat/completions",
      "credentialEnv": "DEEPSEEK_API_KEY",
      "authStoreProvider": "deepseek",
      "reasoningEffort": "max",
      "maxOutputTokens": 32768,
      "timeoutMs": 600000
    },
    "kimi": {
      "adapter": "preset",
      "preset": "kimi-subscription",
      "family": "moonshot",
      "model": "kimi-code/k3",
      "roles": [
        "reviewer"
      ],
      "binaryEnv": "OM_KIMI_BIN",
      "maxInputBytes": 180000,
      "timeoutMs": 600000
    },
    "glm": {
      "adapter": "preset",
      "preset": "opencode-zen",
      "family": "zhipu",
      "model": "glm-5.2",
      "roles": [
        "reviewer"
      ],
      "endpoint": "https://opencode.ai/zen/v1/chat/completions",
      "credentialEnv": "OM_ZEN_KEY",
      "authStoreProvider": "opencode",
      "reasoningEffort": "max",
      "maxOutputTokens": 32768,
      "timeoutMs": 600000
    },
    "mimo": {
      "adapter": "preset",
      "preset": "opencode-zen",
      "family": "xiaomi",
      "model": "mimo-v2.5-free",
      "roles": [
        "reviewer"
      ],
      "endpoint": "https://opencode.ai/zen/v1/chat/completions",
      "credentialEnv": "OM_ZEN_KEY",
      "authStoreProvider": "opencode",
      "reasoningEffort": "max",
      "maxOutputTokens": 32768,
      "timeoutMs": 600000
    }
  },
  "profiles": {
    "multi": {
      "reviewers": [
        "codex",
        "deepseek",
        "kimi",
        "glm",
        "mimo"
      ],
      "maxParallel": 5,
      "maxInputBytes": 180000,
      "reviewPolicy": {
        "mode": "all-required",
        "requiredReviewers": [
          "codex",
          "deepseek",
          "kimi",
          "glm",
          "mimo"
        ]
      }
    }
  }
}
