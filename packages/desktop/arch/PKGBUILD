# Arch Linux package for the cezar desktop shell (Arch, Omarchy, Manjaro, EndeavourOS).
#
# A `-bin` package: it repackages the binary the release workflow built for Debian, against the
# system's own WebKitGTK. That is what the AppImage cannot do — it carries a web view built on
# Ubuntu 22.04, which is the usual cause of a blank window under Wayland on a rolling distro.
#
# `.github/workflows/desktop-release.yml` fills in the version, drops the `.deb` beside this
# file as `cezar.deb`, and runs `makepkg`. To build by hand, do the same two things.

pkgname=cezar-desktop-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Desktop app for cezar, the local cockpit for AI coding agents"
arch=('x86_64')
url="https://github.com/open-mercato/cezar"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
# Not a hard dependency: the shell finds Node through the login shell, so an nvm, volta or fnm
# install counts. With none at all it shows a page that says so.
optdepends=('nodejs: Node.js 20 or newer, required to run cezar (any install on PATH works)'
            'npm: installs and updates cezar itself')
provides=('cezar-desktop')
conflicts=('cezar-desktop')
options=('!strip' '!debug')
source=('cezar.deb')
noextract=('cezar.deb')
sha256sums=('SKIP')

package() {
  mkdir -p "$srcdir/deb"
  bsdtar -xf "$srcdir/cezar.deb" -C "$srcdir/deb"
  bsdtar -xf "$srcdir"/deb/data.tar.* -C "$pkgdir"
}
