<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Push (spec R5). Signing for the App Store switches aps-environment to production.
     keychain-access-groups: the app's own group first, so every existing item keeps its default; the
     second is the device book the Notification Service Extension reads (switcher spec "Push"). -->
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.openmercato.cezar.mobile</string>
		<string>$(AppIdentifierPrefix)com.openmercato.cezar.mobile.devices</string>
	</array>
</dict>
</plist>
