{
  "name": "@open-mercato/cezar-api-client",
  "version": "0.10.0",
  "description": "Typed client and shared contract types for the cezar cockpit HTTP API.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@open-mercato/cezar-contract": "^0.10.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-mercato/cezar",
    "directory": "web/api-client"
  },
  "publishConfig": {
    "access": "public"
  }
}
