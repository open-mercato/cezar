{
  "id": "open-mercato.project-summary",
  "name": "Project summary",
  "version": "0.2.0",
  "apiVersion": "0.1",
  "entry": "dist/index.js",
  "capabilities": ["commands", "panels", "taskEvents"],
  "permissions": ["project.read", "task.create"],
  "contributes": {
    "commands": [
      { "id": "refresh", "label": "Refresh summary", "location": "palette" },
      { "id": "follow-up", "label": "Propose follow-up", "location": "task" }
    ],
    "panels": [
      { "id": "summary", "title": "Project summary" },
      { "id": "counts", "title": "Project summary", "location": "sidebar" },
      { "id": "task", "title": "This task", "location": "task" }
    ]
  }
}
