      "deliver": [
        {
          "ciphertext": "",
          "expect": "fail"
        }
      ]
    },
    {
      "name": "tampered tag",
      "key": "cd18e842e24ce101949abd5bc31261c395c1e93a35694e3b7918dadbcf9d23a5",
      "deliver": [
        {
          "ciphertext": "",
          "expect": "fail"
        }
      ]
    },
    {
      "name": "reordered",
      "key": "cd18e842e24ce101949abd5bc31261c395c1e93a35694e3b7918dadbcf9d23a5",
      "deliver": [
        {
          "ciphertext": "",
          "expect": "fail"
        }
      ]
    },
    {
      "name": "replayed",
      "key": "cd18e842e24ce101949abd5bc31261c395c1e93a35694e3b7918dadbcf9d23a5",
      "deliver": [
        {
          "ciphertext": "",
          "expect": "ok"
        },
        {
          "ciphertext": "",
          "expect": "fail"
        }
      ]
    },
    {
      "name": "reflected from the other direction",
      "key": "cd18e842e24ce101949abd5bc31261c395c1e93a35694e3b7918dadbcf9d23a5",
      "deliver": [
        {
          "ciphertext": "",
          "expect": "fail"
        }
      ]
    },
    {
      "name": "truncated to under one tag",
